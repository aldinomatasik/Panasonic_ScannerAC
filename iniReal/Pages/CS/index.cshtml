    <button type="button" id="manualShiftSubmitBtn" class="btn btn-success" style="font-size:18px; font-weight:600;">
        Akhiri Periode / Submit (untuk Overtime)
    </button>
</div>

<component type="typeof(LossTimeModal)" render-mode="ServerPrerendered" />

@section Scripts {
    <script>
        // Declare 'operat' variable' and initialize it with 0
        var operat = 0;
        var prodpl = 0;
        var intVal = 0;
        var intervalId;

        // ===================== SHIFT/PERIODE (popup based) =====================
        var shiftLabels = { "NS": "Non-Shift", "1": "Shift 1", "2": "Shift 2", "3": "Shift 3" };

        function getShiftWindow(shiftCode) {
            var now = new Date();
            var d = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            if (shiftCode === "NS") {
                var s = new Date(d); s.setHours(7, 0, 0, 0);
                var e = new Date(d); e.setHours(16, 0, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "1") {
                var s = new Date(d); s.setHours(7, 0, 0, 0);
                var e = new Date(d); e.setHours(15, 45, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "2") {
                var s = new Date(d); s.setHours(15, 45, 0, 0);
                var e = new Date(d); e.setHours(23, 0, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "3") {
                var s1 = new Date(d); s1.setHours(23, 0, 0, 0);
                var e1 = new Date(d); e1.setDate(e1.getDate() + 1); e1.setHours(7, 0, 0, 0);
                var s2 = new Date(d); s2.setDate(s2.getDate() - 1); s2.setHours(23, 0, 0, 0);
                var e2 = new Date(d); e2.setHours(7, 0, 0, 0);
                var nowT = now.getTime();
                if (nowT >= s1.getTime()) {
                    return { start: s1.getTime(), end: e1.getTime() };
                }
                return { start: s2.getTime(), end: e2.getTime() };
            }
            return { start: 0, end: 0 };
        }

        function isWithinShiftWindow(shiftCode) {
            var win = getShiftWindow(shiftCode);
            var now = new Date().getTime();
            return now >= win.start && now < win.end;
        }

        function applyShiftSelection(shiftCode) {
            localStorage.setItem("selectedShiftCS", shiftCode);
            localStorage.setItem("selectedShiftDateCS", new Date().toDateString());

            var hiddenInputElement = document.getElementById("shiftModeInput");
            var labelcs = document.getElementById("counterlabelcs");
            var valuecs = document.getElementById("countervaluecs");
            var periodLabel = document.getElementById("currentPeriodLabel");

            hiddenInputElement.value = shiftCode;

            if (isWithinShiftWindow(shiftCode)) {
                if (shiftCode === "NS") {
                    labelcs.textContent = "Non-Shift Total Product : ";
                    valuecs.textContent = "@recordCountNS";
                } else {
                    labelcs.textContent = shiftLabels[shiftCode] + " Total Product : ";
                    valuecs.textContent = "@recordCountCurrentShift";
                }
                periodLabel.textContent = "Periode : " + shiftLabels[shiftCode];
            } else {
                labelcs.textContent = "Overtime - Total Product : ";
                valuecs.textContent = "@latestTotalUnit";
                periodLabel.textContent = "Periode : Overtime (dipilih: " + shiftLabels[shiftCode] + ")";
            }
        }

        function showShiftSelectModal() {
            var modal = new bootstrap.Modal(document.getElementById("ShiftSelectModal"));
            modal.show();
        }

        function showShiftEndModal() {
            var valuecs = document.getElementById("countervaluecs");
            var labelcs = document.getElementById("counterlabelcs");
            document.getElementById("shiftEndTotalDisplay").textContent = valuecs.textContent;
            document.getElementById("shiftEndPeriodLabel").textContent = labelcs.textContent.replace(/:\s*$/, "");
            var endModal = new bootstrap.Modal(document.getElementById("ShiftEndModal"));
            endModal.show();
        }

        function checkShiftBoundary() {
            var selectedShift = localStorage.getItem("selectedShiftCS");
            if (!selectedShift) return;

            if (!isWithinShiftWindow(selectedShift)) {
                var flagKey = "shiftEndPromptedCS_" + selectedShift + "_" + new Date().toDateString();
                if (!sessionStorage.getItem(flagKey)) {
                    showShiftEndModal();
                    sessionStorage.setItem(flagKey, "1");
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var opInput = document.getElementById("opInput");
            var prodInput = document.getElementById("prodInput");
            var opInputValue = document.getElementById("opInputValue");
            var prodInputValue = document.getElementById("prodInputValue");
            setInterval(() => {
                if (opInputValue && opInput) {
                    opInputValue.value = opInput.value;
                }
                if (prodInputValue && prodInput) {
                    prodInputValue.value = prodInput.value;
                }
            }, 500);

            // enter to submit
            const form = document.getElementById("myForm");
            const input = document.getElementById("serialNum");

            form.addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    form.submit();
                }
            });

            const close = document.getElementById('close');
            const closebtn = document.getElementById('CloseCSModal');

            close.addEventListener('click', () => {
                closebtn.click();
            });

            var targInput = document.getElementById("targInput");
            var idleInput = document.getElementById("idleInput");

            var targValue = localStorage.getItem("intVal");
            if (targValue != null) {
                targInput.value = targValue;
                intVal = parseInt(targValue);
            }

            var opValue = localStorage.getItem("opValuecs");
            if (opValue !== null) {
                opInput.value = opValue;
                operat = parseInt(opValue);
            }

            var prodValue = localStorage.getItem("prodValuecs");
            if (prodValue !== null) {
                prodInput.value = prodValue;
                prodpl = parseInt(prodValue);
            }

            updateOPDisplay(opValue);
            updatePPDisplay(prodValue);

            opInput.addEventListener("change", function () {
                localStorage.setItem("opValuecs", opInput.value);
                updateOPDisplay(opInput.value);
                operat = parseInt(opInput.value);
            });
            prodInput.addEventListener("change", function () {
                localStorage.setItem("prodValuecs", prodInput.value);
                updatePPDisplay(prodInput.value);
                prodpl = parseInt(prodInput.value);
            });

            function updateVariable() {
                const now = new Date();

                let startOfShift = new Date(now);
                startOfShift.setHours(7, 0, 0, 0);

                if (now.getHours() < 7) {
                    startOfShift.setDate(startOfShift.getDate() - 1);
                }

                const timeDiffSeconds = Math.floor((now - startOfShift) / 1000);

                const sutVal = @getSUT(currentRecord.Product_Id);
                if (sutVal > 0) {
                    intVal = Math.floor(timeDiffSeconds / sutVal);

                    localStorage.setItem("intValcu", intVal);
                    var targValue = localStorage.getItem("intValcu");
                    if (targValue != null) {
                        targInput.value = targValue;
                    }
                    updateIntValDisplay();
                }
            }

            function updateOPDisplay(value) {
                var opDisplay = document.getElementById("opDisplay");
                opDisplay.textContent = value;
            }

            function updatePPDisplay(value) {
                var prodDisplay = document.getElementById("prodDisplay");
                prodDisplay.textContent = value;
            }

            function updateIntValDisplay() {
                var interDisp = document.getElementById("interDisp");
                interDisp.textContent = intVal;
            }

            // ===== Inisialisasi popup pilih shift saat page dibuka =====
            document.querySelectorAll(".shift-select-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var shiftCode = this.getAttribute("data-shift");
                    applyShiftSelection(shiftCode);
                    var modalEl = document.getElementById("ShiftSelectModal");
                    var modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    var serialInput = document.getElementById("serialNum");
                    if (serialInput) serialInput.focus();
                });
            });

            document.getElementById("confirmShiftEndBtn").addEventListener("click", function () {
                var endModalEl = document.getElementById("ShiftEndModal");
                var endModal = bootstrap.Modal.getInstance(endModalEl);
                if (endModal) endModal.hide();
                localStorage.removeItem("selectedShiftCS");
                localStorage.removeItem("selectedShiftDateCS");
                showShiftSelectModal();
            });

            document.getElementById("manualShiftSubmitBtn").addEventListener("click", function () {
                showShiftEndModal();
            });

            var savedShift = localStorage.getItem("selectedShiftCS");
            var savedDate = localStorage.getItem("selectedShiftDateCS");
            var today = new Date().toDateString();

            if (savedShift && savedDate === today) {
                applyShiftSelection(savedShift);
            } else {
                showShiftSelectModal();
            }

            setInterval(checkShiftBoundary, 30000); // cek tiap 30 detik
            setInterval(updateVariable, 900);
            intVal = parseInt(localStorage.getItem("intVal")) || 0;
            updateIntValDisplay();
        });
    </script>
    }
