    #ShiftEndModal * {
        color: #000000 !important;
    }
</style>

<div class="modal fade" id="ShiftEndModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="ShiftEndModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Konfirmasi Akhir Periode
                </h5>
            </div>

            <!-- Info kecil: Mesin & Periode (tidak terlalu penting, dikecilkan) -->
            <div class="se-mini-info" id="se-info-bar">
                <span>Mesin: <strong>CS Assembly</strong></span>
                <span>Periode: <strong id="shiftEndPeriodLabel">—</strong></span>
                <span>Tanggal: <strong id="shiftEndDateLabel">—</strong></span>
            </div>

            <!-- Total Produksi Hari Ini (highlight besar) -->
            <div class="se-total-section">
                <span class="se-total-label">Total Produksi Hari Ini</span>
                <span class="se-total-value" id="seTotalToday">0</span>
            </div>

            <!-- Model / Serial Pertama / Serial Terakhir -->
            <div class="ms-info-bar">
                <div class="ms-info-chip">
                    <span class="chip-label">Model</span>
                    <span class="chip-value" id="seModelValue">—</span>
                </div>
                <div class="ms-info-chip chip-num">
                    <span class="chip-label">Serial Pertama</span>
                    <span class="chip-value" id="seFirstSerial">—</span>
                </div>
                <div class="ms-info-chip chip-num">
                    <span class="chip-label">Serial Terakhir</span>
                    <span class="chip-value" id="seLastSerial">—</span>
                </div>
            </div>

            <!-- ── Serial Hilang — hanya tampil kalau memang ada yang hilang ── -->
            <div id="se-missing-section" style="display:none;">
                <div class="se-section-label">Serial Hilang</div>
                <div style="padding:0 22px 10px;">

                    <select id="cs-ms-model-filter"
                            class="form-select form-select-sm"
                            style="font-size:14px; color:#0f2a52; font-weight:600; max-width:340px;">

                        <option value="__ALL__">
                            Semua Model
                        </option>

                    </select>

                </div>
                <div class="ms-table-wrap" style="max-height:260px;">
                    <div id="cs-ms-loading" class="ms-loading" style="display:none;">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                        Memuat missing serial...
                    </div>
                    <table class="ms-tbl" id="cs-ms-table" style="display:none;">
                        <thead>
                            <tr>
                                <th>Missing Serial</th>
                                <th style="text-align:center;width:110px;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="cs-ms-tbody"></tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer">
                <span class="se-badge" id="cs-ms-count-badge" style="display:none;">0 serial hilang</span>
                <button type="button" id="confirmShiftEndBtn" class="btn-confirm-shift">
                    Submit &amp; Pilih Periode Baru
                </button>
            </div>

        </div>
    </div>
</div>

<input type="number" class="form-control" name="TU" id="targInput" value="@Model.iniUser.TargetUnit" form="myForm" style="font-size:28px; display:none" />
<input type="hidden" class="form-control" name="IT" id="idleInput" value="@Model.iniUser.IdleTime" form="myForm" style="font-size:28px; display:none " />

@if (currentRecord != null)
{
    <div class="row" style="font-size: 28px; font-weight:500">
        <div class="col-sm-3">
            <label>Current Record :</label>
        </div>
        <div class="col-sm-3">
