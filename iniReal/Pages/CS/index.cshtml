                </div>
            </div>
        </form>
    </div>

    <div class="col-md-3" style="width:49%">
        <div class="row mt-2 mb-2 align-items-center justify-content-center" style="font-size: 20px; font-weight:600">
            <label class="col-sm-6 col-form-label text-end" style="width:220px" id="currentPeriodLabel">Periode : -</label>
        </div>
    </div>

</div>

<div class="modal fade" id="CSProductionModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Produksi CS</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="CloseCSModal"></button>
            </div>
            <div class="modal-body">
                <div>
                    <label class="col col-form-label" style="font-weight:bold;">Masukkan Jumlah Operator!!</label>
                </div>
                <input type="number" class="form-control" name="OP" id="opInput" value="@Model.iniUser.NoOfOperator" form="myForm" style="font-size:28px;" />
                <div>
                    <label class="col col-form-label" style="font-weight:bold;">Masukkan Jumlah Production Plan!!</label>
                </div>
                <input type="number" class="form-control" name="PP" id="prodInput" value="@Model.iniUser.TargetUnit" form="myForm" style="font-size:28px;" />
                <div class="d-flex w-100 justify-content-end">
                    <button id="close" class="btn btn-primary mt-3">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- Modal Pilih Shift/Periode - muncul otomatis saat page dibuka -->
<!-- dan setiap kali periode sebelumnya sudah berakhir             -->
<!-- ============================================================ -->
<div class="modal fade" id="ShiftSelectModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="ShiftSelectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#180D2F; color:#FFAE11;">
                <h5 class="modal-title" id="ShiftSelectModalLabel">Pilih Shift Kerja</h5>
            </div>
            <div class="modal-body">
                <p class="text-center mb-3" style="font-size:16px;">Silakan pilih periode kerja Anda saat ini:</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-primary shift-select-btn" data-shift="NS" style="font-size:18px; padding:12px;">
                        Non-Shift
                    </button>
                    <button type="button" class="btn btn-outline-primary shift-select-btn" data-shift="1" style="font-size:18px; padding:12px;">
                        Shift 1
                    </button>
                    <button type="button" class="btn btn-outline-primary shift-select-btn" data-shift="2" style="font-size:18px; padding:12px;">
                        Shift 2
                    </button>
                    <button type="button" class="btn btn-outline-primary shift-select-btn" data-shift="3" style="font-size:18px; padding:12px;">
                        Shift 3
                    </button>
                </div>
                <p class="text-center text-muted mt-3 mb-0" style="font-size:13px;">
                    Jika Anda memilih shift di luar jam operasionalnya, data otomatis akan dicatat sebagai <strong>Overtime</strong>.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- Modal Konfirmasi Akhir Periode - muncul saat periode berakhir -->
<!-- atau saat tombol submit manual (overtime) dipencet             -->
<!-- ============================================================ -->
<div class="modal fade" id="ShiftEndModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="ShiftEndModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#180D2F; color:#FFAE11;">
