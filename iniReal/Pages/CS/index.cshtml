<component type="typeof(LossTimeModal)" render-mode="ServerPrerendered" />

@section Scripts {
    @* <script src="~/js/sweetalert2.min.js"></script> *@
    <script>
        // Declare 'operat' variable' and initialize it with 0
        var operat = 0;
        var prodpl = 0;
        var intVal = 0;
        var intervalId;

        // ── State missing-serial untuk ShiftEndModal ────────────
        let _csMachineCode = '';
        let _csStartTime = '';
        let _csEndTime = '';
        let _csMissingList = [];
        let _csModelFilter = "__ALL__";

        let _csOverallFirstSerial = "";
        let _csOverallLastSerial = "";


        // ===================== SHIFT/PERIODE (popup based) =====================
        var shiftLabels = { "NS": "Non-Shift", "1": "Shift 1", "2": "Shift 2", "3": "Shift 3" };
                // Status Hari
        var isHoliday = false;

        function getShiftWindow(shiftCode) {
            var now = new Date();
            var d = new Date(now.getFullYear(), now.getMonth(), now.getDate());

            if (shiftCode === "NS") {
                var s = new Date(d); s.setHours(7, 0, 0, 0);
                var e = new Date(d); e.setHours(16, 0, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "1") {
                var s = new Date(d); s.setHours(7, 0, 0, 0);
                var e = new Date(d); e.setHours(15, 45, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "2") {
                var s = new Date(d); s.setHours(15, 45, 0, 0);
                var e = new Date(d); e.setHours(23, 15, 0, 0);
                return { start: s.getTime(), end: e.getTime() };
            }
            if (shiftCode === "3") {
                var s1 = new Date(d); s1.setHours(23, 15, 0, 0);
                var e1 = new Date(d); e1.setDate(e1.getDate() + 1); e1.setHours(7, 0, 0, 0);
                var s2 = new Date(d); s2.setDate(s2.getDate() - 1); s2.setHours(23, 15, 0, 0);
                var e2 = new Date(d); e2.setHours(7, 0, 0, 0);
                var nowT = now.getTime();
                if (nowT >= s1.getTime()) {
                    return { start: s1.getTime(), end: e1.getTime() };
                }
                return { start: s2.getTime(), end: e2.getTime() };
            }
            return { start: 0, end: 0 };
        }

        function isWithinShiftWindow(shiftCode) {
            var win = getShiftWindow(shiftCode);
            var now = new Date().getTime();
            return now >= win.start && now < win.end;
        }

        function applyShiftSelection(shiftCode) {
            localStorage.setItem("selectedShiftCS", shiftCode);
            localStorage.setItem("selectedShiftDateCS", new Date().toDateString());

            var hiddenInputElement = document.getElementById("shiftModeInput");
            var labelcs = document.getElementById("counterlabelcs");
            var valuecs = document.getElementById("countervaluecs");
            var periodLabel = document.getElementById("currentPeriodLabel");

            hiddenInputElement.value = shiftCode;

            if (isWithinShiftWindow(shiftCode)) {
                if (shiftCode === "NS") {
                    labelcs.textContent = "Non-Shift Total Product : ";
                    valuecs.textContent = "@recordCountNS";
                } else {
                    labelcs.textContent = shiftLabels[shiftCode] + " Total Product : ";
                    valuecs.textContent = "@recordCountCurrentShift";
                }
                periodLabel.textContent = "Periode : " + shiftLabels[shiftCode];
            } else {
                labelcs.textContent = "Overtime - Total Product : ";
                valuecs.textContent = "@latestTotalUnit";
                periodLabel.textContent = "Periode : Overtime (dipilih: " + shiftLabels[shiftCode] + ")";
            }
        }

        function showShiftSelectModal() {
            var modal = new bootstrap.Modal(document.getElementById("ShiftSelectModal"));
            modal.show();
        }

        function showShiftEndModal() {
            // Baca nilai dari halaman
            var totalUnit  = (document.getElementById("countervaluecs")?.textContent  || '0').trim();
            var periodText = (document.getElementById("counterlabelcs")?.textContent || '').replace(/:\s*$/, '').trim();
            var currentSN  = (document.getElementById("currentRecordValue")?.textContent || '').trim();
            // Ambil model dari tampilan header CS
            var modelText  = '';
            var modelEl    = document.querySelector("div.col-sm-9 span");
            if (modelEl) modelText = modelEl.textContent.trim();

            // Info kecil (mesin, periode, tanggal) — tidak terlalu penting, dikecilkan
            document.getElementById("shiftEndPeriodLabel").textContent = periodText || '\u2014';
            document.getElementById("shiftEndDateLabel").textContent = new Date().toLocaleDateString('id-ID', {day:'2-digit',month:'long',year:'numeric'});

            // Total Produksi Hari Ini (highlight besar)
            document.getElementById("seTotalToday").textContent = totalUnit;

            // Model / Serial Pertama / Serial Terakhir
            document.getElementById("seModelValue").textContent = modelText || '\u2014';
            document.getElementById("seFirstSerial").textContent = '\u2014';
            document.getElementById("seLastSerial").textContent = currentSN || '\u2014';

            // Isi badge footer (disembunyikan dulu, ditampilkan lagi kalau memang ada yang hilang)
            document.getElementById("cs-ms-count-badge").style.display = "none";
            document.getElementById("se-missing-section").style.display = "none";

            // ── Cek serial hilang untuk periode yang sedang berjalan ──
            var selectedShift = localStorage.getItem("selectedShiftCS");
            var win = selectedShift ? getShiftWindow(selectedShift) : null;

            if (win) {
                _csMachineCode = "MCH1-02";
                _csStartTime   = new Date(win.start).toISOString();
                _csEndTime     = new Date(win.end).toISOString();
                setCsMsState('loading');
                document.getElementById("se-missing-section").style.display = "";
                fetchCsMissingSerials();
            }

            var endModal = new bootstrap.Modal(document.getElementById("ShiftEndModal"));
            endModal.show();
        }

        function setCsMsState(state) {
            document.getElementById('cs-ms-loading').style.display = state === 'loading' ? '' : 'none';
            document.getElementById('cs-ms-table').style.display   = state === 'table'   ? '' : 'none';
            // Kalau tidak ada missing serial ('empty'), seluruh section disembunyikan
            document.getElementById('se-missing-section').style.display = state === 'empty' ? 'none' : '';
        }

        // ── Fetch missing serial untuk periode ini (mirip PWK) ──
        async function fetchCsMissingSerials() {
            try {
                const params = new URLSearchParams({
                    machineCode: _csMachineCode,
                    startTime:   _csStartTime,
                    endTime:     _csEndTime
                });

                const res  = await fetch(`?handler=MissingSerials&${params}`);
                const data = await res.json();

                if (data.error) {
                    setCsMsState('empty');
                    document.getElementById('cs-ms-count-badge').style.display = "none";
                    return;
                }

                // Isi Serial Pertama & Serial Terakhir kalau backend mengirimkannya
                if (data.firstSerial) document.getElementById("seFirstSerial").textContent = data.firstSerial;
                if (data.lastSerial) document.getElementById("seLastSerial").textContent = data.lastSerial;
                if (data.totalToday) document.getElementById("seTotalToday").textContent = data.totalToday;
                if (data.model) document.getElementById("seModelValue").textContent = data.model;

                        _csOverallFirstSerial = data.firstSerial || "";
        _csOverallLastSerial = data.lastSerial || "";

        _csMissingList = data.serials || [];

        populateModelFilter(data.models || []);

        renderCsMissingTable(
            _csMissingList,
            _csModelFilter
        );

        updateSerialFirstLastDisplay();

            } catch (err) {
                setCsMsState('empty');
                document.getElementById('cs-ms-count-badge').style.display = "none";
            }
        }
                function populateModelFilter(models){

            const select =
                document.getElementById(
                    "cs-ms-model-filter"
                );

            select.innerHTML =
                '<option value="__ALL__">Semua Model</option>';

            models.forEach(m=>{

                const opt =
                    document.createElement("option");

                opt.value =
                    m.productId;

                opt.textContent =
                    `${m.productName || m.productId}
                     (${m.productId}) -
                     ${m.missingCount} hilang`;

                opt.dataset.firstSerial =
                    m.firstSerial;

                opt.dataset.lastSerial =
                    m.lastSerial;

                select.appendChild(opt);

            });

            select.onchange=function(){

                _csModelFilter=this.value;

                renderCsMissingTable(
                    _csMissingList,
                    _csModelFilter
                );

                updateSerialFirstLastDisplay();

            };

        }

        function updateSerialFirstLastDisplay(){

            const first =
                document.getElementById("seFirstSerial");

            const last =
                document.getElementById("seLastSerial");

            if(
                _csModelFilter==="__ALL__"
            ){

                first.textContent =
                    _csOverallFirstSerial || "—";

                last.textContent =
                    _csOverallLastSerial || "—";

                return;
            }

            const ddl =
                document.getElementById(
                    "cs-ms-model-filter"
                );

            const opt =
                [...ddl.options]
                .find(x=>x.value===_csModelFilter);

            first.textContent =
                opt?.dataset.firstSerial || "—";

            last.textContent =
                opt?.dataset.lastSerial || "—";

        }

               function renderCsMissingTable(
            serials,
            productId="__ALL__"
        ) {
            const tbody = document.getElementById('cs-ms-tbody');
            const badge = document.getElementById('cs-ms-count-badge');

            tbody.innerHTML = '';

            // serials adalah array of { serial, productId } atau null (sudah di-add)
            let filtered = serials;
            if (productId !== "__ALL__") {
                filtered = serials.filter(x => x !== null && x.productId === productId);
            }

            const remaining = filtered.filter(s => s !== null);

            if (remaining.length === 0) {
                setCsMsState('empty');
                badge.style.display = "none";
                return;
            }

            setCsMsState('table');
            badge.style.display = "";
            badge.textContent = `${remaining.length} serial hilang`;

            // Render semua, tapi pakai index dari array GLOBAL _csMissingList
            // agar addCsSerial bisa null-kan entry yang benar
            _csMissingList.forEach((item, idx) => {
                if (item === null) return; // sudah di-add, skip

                // Filter per model jika dipilih
                if (productId !== "__ALL__" && item.productId !== productId) return;

                const snStr = item.serial;
                const tr = document.createElement('tr');
                tr.dataset.idx = idx;
                tr.innerHTML = `
                    <td class="td-serial">${snStr}</td>
                    <td class="td-action">
                        <button type="button" class="btn-add-serial"
                                onclick="addCsSerial(this, ${idx}, '${snStr}')">
                            + Add
                        </button>
                    </td>`;
                tbody.appendChild(tr);
            });
        }

               // ── Add serial hilang — langsung proses, tanpa popup konfirmasi ──
        async function addCsSerial(btn, idx, serialNumber) {
            btn.disabled = true;
            btn.textContent = '...';

            try {
                const res = await fetch('?handler=AddSerial', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        machineCode:  _csMachineCode,
                        serialNumber: String(serialNumber),
                        startTime:    _csStartTime,
                        endTime:      _csEndTime
                    })
                });

                const data = await res.json();

                if (data.success) {
                    const td = btn.closest('td');
                    td.innerHTML = `<span class="badge-added">✓</span>`;

                    setTimeout(() => {
                        const row = td.closest('tr');
                        row.style.transition = 'opacity 0.3s, transform 0.3s';
                        row.style.opacity = '0';
                        row.style.transform = 'translateX(8px)';
                        setTimeout(() => {
                            _csMissingList[idx] = null;
                            row.remove();

                            const remaining = _csMissingList.filter(s => s !== null).length;
                            const badge = document.getElementById('cs-ms-count-badge');
                            if (remaining === 0) {
                                setCsMsState('empty');
                                badge.style.display = "none";
                            } else {
                                badge.textContent = `${remaining} serial hilang`;
                            }
                        }, 300);
                    }, 800);

                } else {
                    btn.disabled = false;
                    btn.textContent = '+ Add';
                    const td = btn.closest('td');
                    const errSpan = document.createElement('div');
                    errSpan.style.cssText = 'color:#c62828; font-size:12px; margin-top:4px;';
                    errSpan.textContent = data.error || 'Gagal menambahkan';
                    td.appendChild(errSpan);
                    setTimeout(() => errSpan.remove(), 3000);
                }

            } catch (err) {
                btn.disabled = false;
                btn.textContent = '+ Add';
                const td = btn.closest('td');
                const errSpan = document.createElement('div');
                errSpan.style.cssText = 'color:#c62828; font-size:12px; margin-top:4px;';
                errSpan.textContent = 'Gagal menghubungi server';
                td.appendChild(errSpan);
                setTimeout(() => errSpan.remove(), 3000);
            }
        }

        // ── Anti-forgery token helper (form#myForm sudah otomatis punya
        //    hidden __RequestVerificationToken lewat form tag helper) ──
        function getAntiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value
                ?? document.cookie.split(';').find(c => c.trim().startsWith('XSRF-TOKEN='))?.split('=')[1]
                ?? '';
        }

        function checkShiftBoundary() {
            var selectedShift = localStorage.getItem("selectedShiftCS");
            if (!selectedShift) return;

            if (!isWithinShiftWindow(selectedShift)) {
                var flagKey = "shiftEndPromptedCS_" + selectedShift + "_" + new Date().toDateString();
                if (!sessionStorage.getItem(flagKey)) {
                    showShiftEndModal();
                    sessionStorage.setItem(flagKey, "1");
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var opInput = document.getElementById("opInput");
            var prodInput = document.getElementById("prodInput");
            var opInputValue = document.getElementById("opInputValue");
            var prodInputValue = document.getElementById("prodInputValue");
            setInterval(() => {
                if (opInputValue && opInput) {
                    opInputValue.value = opInput.value;
                }
                if (prodInputValue && prodInput) {
                    prodInputValue.value = prodInput.value;
                }
            }, 500);

            // enter to submit
            const form = document.getElementById("myForm");
            const input = document.getElementById("serialNum");

            form.addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    form.submit();
                }
            });

            const close = document.getElementById('close');
            const closebtn = document.getElementById('CloseCSModal');

            close.addEventListener('click', () => {
                closebtn.click();
            });

            var targInput = document.getElementById("targInput");
            var idleInput = document.getElementById("idleInput");

            var targValue = localStorage.getItem("intVal");
            if (targValue != null) {
                targInput.value = targValue;
                intVal = parseInt(targValue);
            }

            var opValue = localStorage.getItem("opValuecs");
            if (opValue !== null) {
                opInput.value = opValue;
                operat = parseInt(opValue);
            }

            var prodValue = localStorage.getItem("prodValuecs");
            if (prodValue !== null) {
                prodInput.value = prodValue;
                prodpl = parseInt(prodValue);
            }

            updateOPDisplay(opValue);
            updatePPDisplay(prodValue);

            opInput.addEventListener("change", function () {
                localStorage.setItem("opValuecs", opInput.value);
                updateOPDisplay(opInput.value);
                operat = parseInt(opInput.value);
            });
            prodInput.addEventListener("change", function () {
                localStorage.setItem("prodValuecs", prodInput.value);
                updatePPDisplay(prodInput.value);
                prodpl = parseInt(prodInput.value);
            });

            function updateVariable() {
                const now = new Date();

                let startOfShift = new Date(now);
                startOfShift.setHours(7, 0, 0, 0);

                if (now.getHours() < 7) {
                    startOfShift.setDate(startOfShift.getDate() - 1);
                }

                const timeDiffSeconds = Math.floor((now - startOfShift) / 1000);

                const sutVal = @(currentRecord != null ? getSUT(currentRecord.Product_Id) : 0);
                if (sutVal > 0) {
                    intVal = Math.floor(timeDiffSeconds / sutVal);

                    localStorage.setItem("intValcu", intVal);
                    var targValue = localStorage.getItem("intValcu");
                    if (targValue != null) {
                        targInput.value = targValue;
                    }
                    updateIntValDisplay();
                }
            }

            function updateOPDisplay(value) {
                var opDisplay = document.getElementById("opDisplay");
                opDisplay.textContent = value;
            }

            function updatePPDisplay(value) {
                var prodDisplay = document.getElementById("prodDisplay");
                prodDisplay.textContent = value;
            }

            function updateIntValDisplay() {
                var interDisp = document.getElementById("interDisp");
                interDisp.textContent = intVal;
            }

            // ===== Inisialisasi popup pilih shift saat page dibuka =====
                    document.querySelectorAll(".shift-select-btn").forEach(function (btn) {

            btn.addEventListener("click", function () {

                var shiftCode = this.getAttribute("data-shift");

                applyShiftSelection(shiftCode);

                var modalEl = document.getElementById("ShiftSelectModal");
                var modalInstance = bootstrap.Modal.getInstance(modalEl);

                if (modalInstance)
                    modalInstance.hide();

                new bootstrap.Modal(
                    document.getElementById("HolidaySelectModal")
                ).show();

            });

        });
                document.querySelectorAll(".holiday-select-btn").forEach(function (btn) {

            btn.addEventListener("click", function () {

                isHoliday = this.dataset.holiday === "true";

                document.getElementById("isHolidayInput").value = isHoliday;

                localStorage.setItem("isHolidayCS", isHoliday);

                var modal =
                    bootstrap.Modal.getInstance(
                        document.getElementById("HolidaySelectModal")
                    );

                if (modal)
                    modal.hide();

                var serialInput = document.getElementById("serialNum");

                if (serialInput)
                    serialInput.focus();

            });

        });

            document.getElementById("confirmShiftEndBtn").addEventListener("click", function () {
                var endModalEl = document.getElementById("ShiftEndModal");
                var endModal = bootstrap.Modal.getInstance(endModalEl);
                if (endModal) endModal.hide();
localStorage.removeItem("selectedShiftCS");
        localStorage.removeItem("selectedShiftDateCS");
        localStorage.removeItem("isHolidayCS");

        showShiftSelectModal();
            });

            document.getElementById("manualShiftSubmitBtn").addEventListener("click", function () {
                showShiftEndModal();
            });

            var savedShift = localStorage.getItem("selectedShiftCS");
                    var savedHoliday =
            localStorage.getItem("isHolidayCS");

        if (savedHoliday != null) {

            isHoliday = savedHoliday === "true";

            document.getElementById("isHolidayInput").value =
                savedHoliday;

        }
            var savedDate = localStorage.getItem("selectedShiftDateCS");
            var today = new Date().toDateString();

                   if (
            savedShift &&
            savedDate === today &&
            savedHoliday != null
        ) {

            applyShiftSelection(savedShift);

        } else {

            showShiftSelectModal();

        }

            setInterval(checkShiftBoundary, 30000); // cek tiap 30 detik
            setInterval(updateVariable, 900);
            intVal = parseInt(localStorage.getItem("intVal")) || 0;
            updateIntValDisplay();
        });
    </script>
    }
